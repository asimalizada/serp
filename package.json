{
  "name": "serp",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @serp/api --filter @serp/web dev",
    "dev:api": "pnpm --filter @serp/api dev",
    "dev:web": "pnpm --filter @serp/web dev",
    "build": "pnpm --filter @serp/shared build && pnpm --filter @serp/api build && pnpm --filter @serp/web build",
    "start:api": "pnpm --filter @serp/api start",
    "start:web": "pnpm --filter @serp/web start",
    "db:validate": "pnpm --filter @serp/api prisma:validate",
    "db:generate": "pnpm --filter @serp/api prisma:generate",
    "db:migrate:dev": "pnpm --filter @serp/api prisma:migrate:dev",
    "db:migrate:deploy": "pnpm --filter @serp/api prisma:migrate:deploy"
  }
}
