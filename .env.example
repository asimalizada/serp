# Copy to .env and set your own password. Keep the URL credentials in sync.
POSTGRES_USER=serp
POSTGRES_PASSWORD=serp
POSTGRES_DB=serp
POSTGRES_PORT=5432
DATABASE_URL=postgresql://serp:serp@localhost:5432/serp

# Required for `pnpm seed`. Set distinct development-only passwords (12–72 UTF-8 bytes).
SEED_USER_A_PASSWORD=
SEED_USER_B_PASSWORD=